--FUNCTIONS
CREATE OR REPLACE FUNCTION auto_log_fn()
RETURNS trigger
AS $$
BEGIN
  INSERT INTO audit_log(user_id, action, target_table, target_id)
  VALUES (
    COALESCE(NEW.user_id, OLD.user_id),
    TG_OP,
    TG_TABLE_NAME,
    COALESCE(OLD.user_id, NEW.user_id)
  );
  RETURN NULL;
END;
$$ LANGUAGE plpgsql;

--TRIGGERS
CREATE TRIGGER auto_log
AFTER INSERT OR UPDATE OR DELETE ON users
FOR EACH ROW
EXECUTE FUNCTION auto_log_fn();

CREATE TRIGGER auto_log
AFTER INSERT OR UPDATE OR DELETE ON expenses
FOR EACH ROW
EXECUTE FUNCTION auto_log_fn();

CREATE TRIGGER auto_log
AFTER INSERT OR UPDATE OR DELETE ON budgets
FOR EACH ROW
EXECUTE FUNCTION auto_log_fn();

--VIEWS
create view spent_by_category as(
  select u.user_id, u.username, e.category_id, c.name, sum(e.amount) AS total_spent from users u
  join expenses e on e.user_id = u.user_id
  join categories c on c.category_id = e.category_id
  group by u.user_id, u.username, e.category_id, c.name
);

create view total_spent_monthly as(
  select u.user_id, u.username, sum(e.amount) AS spent_monthly from users u
  join expenses e on e.user_id = u.user_id
  group by u.user_id, u.username, date_trunc('month', e.expense_date)
);

CREATE VIEW budget_vs_actual AS
SELECT u.user_id, u.username, c.category_id, c.name,
       SUM(e.amount) AS total_spent,
       b.budget_id, b.amount_limit, b.start_date, b.end_date
FROM users u
JOIN expenses e ON e.user_id = u.user_id
JOIN categories c ON c.category_id = e.category_id
JOIN budgets b ON b.user_id = u.user_id AND b.category_id = c.category_id
WHERE e.expense_date >= b.start_date AND e.expense_date <= b.end_date
GROUP BY u.user_id, u.username, c.category_id, c.name, 
         b.budget_id, b.amount_limit, b.start_date, b.end_date;

--select * from recent_transactions where user_id = user_id (in flask)
CREATE VIEW recent_transactions AS
SELECT u.user_id, u.username, c.name AS category, 
       e.amount, e.expense_date, e.notes
FROM users u
JOIN expenses e ON e.user_id = u.user_id
JOIN categories c ON c.category_id = e.category_id
ORDER BY e.expense_date DESC;
